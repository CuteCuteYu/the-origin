        "items": [
          ["会话", "陈静 ↔ 周明远"],
          ["时间", "2026-10-13（周二）18:43 - 18:56"]
        ]
      },
      {
        "type": "im",
        "messages": [
          { "from": "陈静", "time": "18:43", "text": "周工，你有个大箱子在前台，我推了一下纹丝不动（笑哭）。是给果果买的吗？" },
          { "from": "周明远", "time": "18:51", "text": "机器人课的零件，她念叨两周了。别搬，明天我自己来。" },
          { "from": "陈静", "time": "18:52", "text": "我先给它盖张纸，省得被孙哥当样品拆了" },
          { "from": "周明远", "time": "18:53", "text": "他拆了让他赔。谢了，登记记我名下。" },
          { "from": "陈静", "time": "18:54", "text": "早记您名下了。门禁时代，流程走得明明白白（狗头）" },
          { "from": "周明远", "time": "18:56", "text": "……行，明天见。" }
        ]
      },
      {
        "type": "callout",
        "tone": "info",
        "text": "记录由管理员导出归档。"
      }
    ]
